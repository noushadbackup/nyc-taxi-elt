# Copy to .env and fill in (`make init` does this for you).

# Your host user id, so files Airflow writes stay owned by you (Linux).
AIRFLOW_UID=50000

# duckdb = run everything locally, no cloud account needed
# bigquery = load into GCS + BigQuery (run `make tf-apply` first)
WAREHOUSE_TARGET=duckdb
DBT_TARGET=duckdb

# First month the DAG backfills from (TLC data is published ~2 months late).
START_MONTH=2025-06

# --- BigQuery target only ---------------------------------------------------
GCP_PROJECT_ID=
GCS_BUCKET=
BQ_LOCATION=US
BQ_RAW_DATASET=raw
BQ_DBT_DATASET=nyc_taxi
# Service account key created by Terraform (`make tf-key`), mounted read-only.
GOOGLE_APPLICATION_CREDENTIALS=
